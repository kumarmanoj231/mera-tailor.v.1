# MeraTailor Environment Configuration
# Local dev port (DO NOT set PORT in Render dashboard; Render manages port 10000 automatically)
PORT=5000
NODE_ENV=development

# Database Configuration
# Local: mongodb://127.0.0.1:27017/meratailor
# Production (Render): mongodb+srv://<db_user>:<db_password>@cluster0.xxxx.mongodb.net/meratailor?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/meratailor

# Clerk Authentication (https://dashboard.clerk.com -> API Keys)
# Required for frontend client authentication (baked into Vite bundle at build time)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend Clerk credentials (Required for verifying sessions and webhooks)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Google AI Studio Gemini API (https://aistudio.google.com/app/apikey)
# Server-only key used for Hindi/English voice transcription
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Comma-separated Clerk user IDs pre-authorized for the admin role
CLERK_ADMIN_IDS=
