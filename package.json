{
  "name": "meratailor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm:server:dev\" \"npm:client:dev\"",
    "client:dev": "vite --host 0.0.0.0",
    "server:dev": "nodemon --watch server --ext js,json server/index.js",
    "demo:users": "node scripts/create-demo-clerk-users.js",
    "reset:tailors": "node scripts/reset-seed-tailors.js",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@clerk/express": "^2.1.75",
    "@clerk/react": "^6.17.5",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "i18next": "^26.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.51.0",
    "mongoose": "^8.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.4",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.7"
  }
}
